[Unit]
Description=CoreStation 実測コレクター（推論probe込みフル計測 + Pages デプロイ判定）
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__CORESTATION_HOME__
Environment=CORESTATION_HOME=__CORESTATION_HOME__
ExecStart=/usr/bin/python3 __CORESTATION_HOME__/scripts/dashboard_live.py --deploy --min-deploy-interval-min 120
StandardOutput=append:__CORESTATION_HOME__/logs/dashboard_live_full.log
StandardError=append:__CORESTATION_HOME__/logs/dashboard_live.err.log
